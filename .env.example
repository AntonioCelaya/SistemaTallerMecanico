# Application
NODE_ENV=development
APP_NAME="Sistema de Taller Mecanico"
APP_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000
JWT_SECRET=replace-with-a-secure-local-secret
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000,tauri://localhost,capacitor://localhost,http://localhost

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taller_mecanico
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=replace-with-a-secure-db-password
DATABASE_URL=postgresql://taller_user:replace-with-a-secure-db-password@localhost:5432/taller_mecanico?schema=public

# Optional pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@taller.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-secure-pgadmin-password

# Updates / releases
UPDATE_CHANNEL=development
DESKTOP_UPDATE_ENDPOINT=http://localhost:4000/updates/desktop


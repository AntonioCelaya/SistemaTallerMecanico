{
  "name": "sistema-taller-mecanico",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo para sistema local de administracion de taller mecanico.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @taller/database build && pnpm --filter @taller/api --filter @taller/web --parallel dev",
    "setup": "pnpm install && pnpm --filter @taller/database build && pnpm db:deploy && pnpm db:seed",
    "build": "pnpm -r --filter \"!@taller/mobile\" --filter \"!@taller/desktop\" build",
    "start": "pnpm build && pnpm db:deploy && pnpm --filter @taller/api --filter @taller/web --parallel start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @taller/database db:generate",
    "db:migrate": "pnpm --filter @taller/database db:migrate",
    "db:deploy": "pnpm --filter @taller/database db:deploy",
    "db:seed": "pnpm --filter @taller/database db:seed",
    "db:studio": "pnpm --filter @taller/database db:studio"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  TECNICO
}

model Usuario {
  id                   String    @id @default(uuid())
  email                String    @unique
  nombre               String
  passwordHash         String
  rol                  Rol       @default(TECNICO)
  activo               Boolean   @default(true)
  /// Intentos de login fallidos seguidos; se reinicia al entrar correctamente.
  intentosFallidos     Int       @default(0)
  /// Si tiene fecha futura, la cuenta esta bloqueada temporalmente.
  bloqueadoHasta       DateTime?
  /// Las sesiones iniciadas antes de esta fecha dejan de ser validas.
  sesionesValidasDesde DateTime  @default(now())
  creadoEn             DateTime  @default(now())
  actualizadoEn        DateTime  @updatedAt

  @@map("usuarios")
}

model Cliente {
  id            String     @id @default(uuid())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  rfc           String?
  notas         String?
  vehiculos     Vehiculo[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([nombre])
  @@map("clientes")
}

model Vehiculo {
  id            String   @id @default(uuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  marca         String
  modelo        String
  anio          Int?
  placas        String   @unique
  vin           String?  @unique
  color         String?
  kilometraje   Int?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([clienteId])
  @@map("vehiculos")
}

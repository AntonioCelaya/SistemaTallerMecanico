{
  "name": "@taller/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migraciones y acceso a datos compartido.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "echo \"No lint configured yet for @taller/database\"",
    "test": "echo \"No tests configured yet for @taller/database\"",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
